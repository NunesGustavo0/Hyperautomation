
#Configuração do BOTCITY
MAESTRO_SERVER=https://SEU-MAESTRO.botcity.dev
MAESTRO_LOGIN=seu_usuario
MAESTRO_KEY=sua_chave
#Definindo se o bot tem que conectar (Caso true, ele tentará)
MAESTRO_ENABLED=true

#Configuração de Fila e Credencial
VAULT_ENABLED=true
AUDITORIA_DATAPOOL_LABEL=FilaAuditoriaLotes_equipe1
CREDENTIAL_LABEL=credencial_erp_equipe1
CREDENTIAL_USER_KEY=username
CREDENTIAL_PASSWORD_KEY=password

# Configuração da automação web
# Deve corresponder à variável lida por src/config.py.
URL_BASE=http://localhost:8081
CAMINHO_EVIDENCIA=screenshots/print.jpg
ENVIRONMENT=local

#Definindo se o navegador deve abrir (Caso TRUE, ele vai abrir)
HEADLESS=true

#Identificadores para os logs estruturados
BOT_ID=bot-conferencia-local
EXECUCAO_ID=exec-local-0000
