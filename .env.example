
#Configuração do BOTCITY
MAESTRO_SERVER=https://SEU-MAESTRO.botcity.dev
MAESTRO_LOGIN=seu_usuario
MAESTRO_KEY=sua_chave
#Definindo se o bot tem que conectar (Caso true, ele tentará)
MAESTRO_ENABLED=true

#Configuração de Fila e Credencial
VAULT_ENABLED=true
AUDITORIA_DATAPOOL_LABEL=FilaAuditoriaLotes_equipe1
CREDENTIAL_LABEL=credencial_erp_equipe1
CREDENTIAL_USER_KEY=username
CREDENTIAL_PASSWORD_KEY=password

# Configuração da automação web
# Deve corresponder à variável lida por src/config.py.
URL_BASE=http://localhost:8080
CAMINHO_EVIDENCIA=screenshots/comprovante_lote_9999.png

#Definindo se o navegador deve abrir (Caso TRUE, ele vai abrir)
HEADLESS=false

#Identificadores para os logs estruturados
BOT_ID=bot-conferencia-local
EXECUCAO_ID=exec-local-0000

# Pipeline hibrido RPA + Machine learning
# false mantém somente as regras tradicionais de RN01-RN12
ML_ENABLED=false
#Endereço usado quando a API ML é executada localmente.
ML_API_URL=http://localhost:8000

#Confiança mínima para aceitar a causa sugerida pelo modelo
ML_CONFIANCA_MINIMA=0.75

#Tempo máximo de espera pela API, em segundos.
ML_TIMEOUT_SECONDS=3.0

# Canal principal de alertas
TELEGRAM_BOT_TOKEN=seu_token_do_bot
TELEGRAM_CHAT_ID=seu_chat_id
TELEGRAM_TIMEOUT_SECONDS=5
# Infraestrutura crítica: base de referência
BASE_REFERENCIA_MAX_TENTATIVAS=3
BASE_REFERENCIA_BACKOFF_SECONDS=1

# Canal secundário de Email para ERRO e CRÍTICO
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT_SECONDS=10

CAMINHO_ENTRADA=
